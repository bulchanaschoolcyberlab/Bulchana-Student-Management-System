
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Contact Us | Bulchana School</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
:root {
 --navy:#102747;
 --deep:#091a30;
 --blue:#1765c1;
 --gold:#e5ad42;
 --light:#f4f7fb;
 --white:#fff;
 --text:#26364a;
 --muted:#718096;
 --border:#e4eaf2;
}

*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'DM Sans',sans-serif;color:var(--text);line-height:1.7}
h1,h2,h3,h4{font-family:'Manrope',sans-serif;line-height:1.25;color:var(--navy)}
a{text-decoration:none;color:inherit}
.container{width:min(1140px,92%);margin:auto}

.topbar{background:var(--deep);color:#dce6f3;padding:9px 0;font-size:12px}
.topbar-inner{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}

header{background:white;position:sticky;top:0;z-index:100;box-shadow:0 3px 18px #10274712}
.nav{min-height:78px;display:flex;align-items:center;justify-content:space-between;gap:20px}
.brand{display:flex;align-items:center;gap:11px}
.logo{width:45px;height:45px;border-radius:12px;background:var(--navy);color:var(--gold);display:grid;place-items:center;font-weight:800;font-size:19px}
.brand-name{font-weight:800;color:var(--navy);font-size:18px}
.brand-sub{font-size:10px;color:var(--muted);letter-spacing:1px}

.nav-links{display:flex;align-items:center;gap:22px}
.nav-links a{font-size:13px;font-weight:700;color:#34465d}
.nav-links a:hover,.nav-links a.active{color:var(--blue)}
.nav-links .login{background:var(--blue);color:white;padding:11px 18px;border-radius:8px}

.menu-btn{display:none;border:0;background:var(--light);color:var(--navy);width:42px;height:42px;border-radius:9px;font-size:23px;cursor:pointer}

.hero{
 min-height:340px;
 display:flex;
 align-items:center;
 color:white;
 background:linear-gradient(90deg,rgba(7,24,46,.95),rgba(7,24,46,.68)),
 url('https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=1800&q=85') center/cover;
}

.hero-content{padding:75px 0}
.eyebrow{color:var(--gold);font-size:12px;font-weight:800;letter-spacing:2px;text-transform:uppercase;margin-bottom:17px;display:inline-block}
.hero h1{color:white;font-size:clamp(38px,6vw,58px);margin-bottom:18px}
.hero p{color:#e1e9f3;max-width:650px;font-size:16px}

section{padding:75px 0}
.section-label{color:var(--blue);text-transform:uppercase;letter-spacing:2px;font-size:11px;font-weight:800;margin-bottom:12px}
.section-title{font-size:clamp(27px,4vw,38px);margin-bottom:15px}
.section-desc{max-width:700px;color:var(--muted);font-size:15px}

.contact-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:35px;align-items:start}
.contact-info{display:grid;gap:17px;margin-top:28px}

.info-item{display:flex;gap:15px;padding:19px;border:1px solid var(--border);border-radius:12px;background:white}
.info-icon{width:43px;height:43px;flex-shrink:0;display:grid;place-items:center;background:#eaf2fc;color:var(--blue);border-radius:11px;font-size:20px}
.info-item h3{font-size:15px;margin-bottom:4px}
.info-item p{font-size:13px;color:var(--muted)}
.info-item a{color:var(--blue)}

.contact-form{background:white;border:1px solid var(--border);border-radius:16px;padding:32px;box-shadow:0 12px 35px #1027470a}
.contact-form h2{font-size:24px;margin-bottom:8px}
.form-desc{font-size:13px;color:var(--muted);margin-bottom:24px}

.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:17px}
.field{display:grid;gap:7px}
.field.full{grid-column:1/-1}
.field label{font-size:12px;font-weight:700;color:var(--navy)}

.field input,.field select,.field textarea{
 width:100%;
 padding:13px 14px;
 border:1px solid var(--border);
 border-radius:8px;
 font:inherit;
 font-size:13px;
 outline:none;
 background:#fff;
 color:var(--text);
}

.field input:focus,.field select:focus,.field textarea:focus{
 border-color:var(--blue);
 box-shadow:0 0 0 3px #1765c115;
}

.field textarea{min-height:145px;resize:vertical}

.submit-btn{
 margin-top:20px;
 border:0;
 background:var(--blue);
 color:white;
 padding:14px 23px;
 border-radius:8px;
 font-size:13px;
 font-weight:800;
 cursor:pointer;
 width:100%;
}

.submit-btn:hover{background:var(--navy)}
.form-note{font-size:11px;color:var(--muted);margin-top:12px;text-align:center}

.help-section{background:var(--light)}
.help-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:35px}
.help-card{background:white;border:1px solid var(--border);border-radius:13px;padding:25px}
.help-card h3{font-size:17px;margin-bottom:9px}
.help-card p{font-size:13px;color:var(--muted);margin-bottom:15px}
.help-card a{font-size:12px;color:var(--blue);font-weight:800}

.cta{background:var(--navy);color:white;text-align:center;padding:60px 20px}
.cta h2{color:white;font-size:clamp(26px,4vw,36px);margin-bottom:13px}
.cta p{color:#d2dfed;max-width:620px;margin:0 auto 25px;font-size:14px}

.btn{display:inline-flex;align-items:center;justify-content:center;padding:13px 22px;border-radius:8px;font-size:13px;font-weight:800;transition:.2s}
.btn:hover{transform:translateY(-3px)}
.btn-primary{background:var(--gold);color:var(--deep)}
.btn-outline{border:1px solid #ffffff85;color:white}

footer{background:var(--deep);color:#c9d5e3;padding:50px 0 20px}
.footer-grid{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:35px;padding-bottom:35px}
.footer-brand{color:white;font-size:20px;font-weight:800;margin-bottom:12px}
footer p{font-size:13px;color:#aebdce;max-width:310px}
footer h4{color:white;font-size:14px;margin-bottom:17px}
.footer-links{display:grid;gap:10px}
.footer-links a{font-size:13px;color:#b8c7d8}
.footer-links a:hover{color:var(--gold)}
.copyright{border-top:1px solid #ffffff20;padding-top:20px;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;font-size:11px;color:#94a8bd}

@media(max-width:850px){
 .nav-links{display:none;position:absolute;top:78px;left:0;right:0;background:white;padding:20px 5%;box-shadow:0 12px 20px #10274715;flex-direction:column;align-items:stretch;gap:0}
 .nav-links.show{display:flex}
 .nav-links a{padding:12px 0}
 .nav-links .login{text-align:center;margin-top:8px}
 .menu-btn{display:block}
 .contact-grid{grid-template-columns:1fr}
 .help-grid{grid-template-columns:1fr 1fr}
 .footer-grid{grid-template-columns:repeat(2,1fr)}
}

@media(max-width:580px){
 section{padding:55px 0}
 .hero{min-height:380px}
 .hero-content{padding:60px 0}
 .form-grid{grid-template-columns:1fr}
 .field.full{grid-column:auto}
 .contact-form{padding:22px}
 .help-grid{grid-template-columns:1fr}
 .footer-grid{grid-template-columns:1fr 1fr;gap:25px}
 .topbar-inner{justify-content:center;text-align:center}
}
</style>
</head>

<body>

<div class="topbar">
 <div class="container topbar-inner">
  <span>Welcome to Bulchana School</span>
  <span>Learning Today · Leading Tomorrow</span>
 </div>
</div>

<header>
 <div class="container nav">

  <a href="index.html" class="brand">
   <div class="logo">B</div>
   <div>
    <div class="brand-name">BULCHANA SCHOOL</div>
    <div class="brand-sub">EDUCATION FOR EXCELLENCE</div>
   </div>
  </a>

  <button class="menu-btn" id="menuBtn" aria-label="Open navigation" aria-expanded="false">☰</button>

  <nav class="nav-links" id="navLinks">
   <a href="index.html">Home</a>
   <a href="about.html">About</a>
   <a href="academics.html">Academics</a>
   <a href="admissions.html">Admissions</a>
   <a href="announcements.html">News</a>
   <a href="contact.html" class="active">Contact</a>
   <a href="login.html" class="login">Student Portal ↗</a>
  </nav>

 </div>
</header>

<main>

<section class="hero">
 <div class="container hero-content">
  <span class="eyebrow">We're Here to Help</span>
  <h1>Contact Bulchana School</h1>
  <p>Have a question about admissions, academics, or student services? Find the right way to reach us.</p>
 </div>
</section>

<section>
 <div class="container contact-grid">

  <div>
   <div class="section-label">Get in Touch</div>
   <h2 class="section-title">We'd Love to Hear From You</h2>
   <p class="section-desc">Choose the appropriate school service for your question. Official contact details can be added here when confirmed by the school.</p>

   <div class="contact-info">

    <div class="info-item">
     <div class="info-icon">📍</div>
     <div>
      <h3>School Location</h3>
      <p>Bulchana School<br>Official address to be provided by the school.</p>
     </div>
    </div>

    <div class="info-item">
     <div class="info-icon">✉️</div>
     <div>
      <h3>Email Address</h3>
      <p>Official school email to be added.</p>
     </div>
    </div>

    <div class="info-item">
     <div class="info-icon">☎️</div>
     <div>
      <h3>Phone Number</h3>
      <p>Official school phone number to be added.</p>
     </div>
    </div>

    <div class="info-item">
     <div class="info-icon">🕒</div>
     <div>
      <h3>Office Hours</h3>
      <p>Please contact the school to confirm office hours.</p>
     </div>
    </div>

   </div>
  </div>

  <div class="contact-form">
   <h2>Send Us a Message</h2>
   <p class="form-desc">Complete the fields below. This form is a design preview and is not connected to message delivery yet.</p>

   <form id="contactForm">
    <div class="form-grid">

     <div class="field">
      <label for="fullName">Full Name</label>
      <input id="fullName" name="fullName" type="text" placeholder="Your full name" required>
     </div>

     <div class="field">
      <label for="email">Email Address</label>
      <input id="email" name="email" type="email" placeholder="you@example.com" required>
     </div>

     <div class="field full">
      <label for="subject">Subject</label>
      <select id="subject" name="subject" required>
       <option value="">Choose a subject</option>
       <option>Admissions</option>
       <option>Academic Information</option>
       <option>Student Services</option>
       <option>Technical Support</option>
       <option>Other</option>
      </select>
     </div>

     <div class="field full">
      <label for="message">Your Message</label>
      <textarea id="message" name="message" placeholder="Write your message here..." required></textarea>
     </div>

    </div>

    <button type="submit" class="submit-btn">Send Message →</button>
    <p class="form-note">Message delivery will be enabled after a secure backend connection is configured.</p>
   </form>
  </div>

 </div>
</section>

<section class="help-section">
 <div class="container">

  <div class="section-label">Find the Right Department</div>
  <h2 class="section-title">How Can We Help?</h2>
  <p class="section-desc">Use these pages to find information about common school services.</p>

  <div class="help-grid">

   <div class="help-card">
    <h3>🎓 Admissions</h3>
    <p>Learn about registration, academic placement, and school-fee requirements.</p>
    <a href="admissions.html">View Admissions →</a>
   </div>

   <div class="help-card">
    <h3>📚 Academics</h3>
    <p>Explore grade levels, learning pathways, and academic information.</p>
    <a href="academics.html">Explore Academics →</a>
   </div>

   <div class="help-card">
    <h3>🔐 Student Portal</h3>
    <p>Access your account and the school services available to your role.</p>
    <a href="login.html">Open Student Portal →</a>
   </div>

  </div>
 </div>
</section>

<section class="cta">
 <div class="container">
  <div class="section-label">Bulchana School</div>
  <h2>Education for a Brighter Future</h2>
  <p>Explore our school website and discover the learning opportunities available at Bulchana School.</p>
  <a href="admissions.html" class="btn btn-primary">Explore Admissions →</a>
  <a href="index.html" class="btn btn-outline" style="margin-left:8px">Back to Home</a>
 </div>
</section>

</main>

<footer>
 <div class="container">

  <div class="footer-grid">

   <div>
    <div class="footer-brand">BULCHANA SCHOOL</div>
    <p>Empowering students through quality education, technology, innovation, and a commitment to a brighter future.</p>
   </div>

   <div>
    <h4>Explore</h4>
    <div class="footer-links">
     <a href="index.html">Home</a>
     <a href="about.html">About Us</a>
     <a href="academics.html">Academics</a>
     <a href="admissions.html">Admissions</a>
    </div>
   </div>

   <div>
    <h4>Student Resources</h4>
    <div class="footer-links">
     <a href="login.html">Student Portal</a>
     <a href="digital-learning.html">Digital Learning</a>
     <a href="announcements.html">Announcements</a>
     <a href="student-life.html">Student Life</a>
    </div>
   </div>

   <div>
    <h4>Connect</h4>
    <div class="footer-links">
     <a href="contact.html">Contact Us</a>
     <a href="login.html">Teacher Portal</a>
     <a href="login.html">Admin Portal</a>
    </div>
   </div>

  </div>

  <div class="copyright">
   <span>© <span id="year"></span> Bulchana School. All rights reserved.</span>
   <span>IT Department | Technology | Innovation</span>
  </div>

 </div>
</footer>

<script>
const menuBtn = document.getElementById("menuBtn");
const navLinks = document.getElementById("navLinks");

menuBtn.addEventListener("click", function() {
 const isOpen = navLinks.classList.toggle("show");
 menuBtn.setAttribute("aria-expanded", String(isOpen));
 menuBtn.textContent = isOpen ? "✕" : "☰";
});

navLinks.querySelectorAll("a").forEach(function(link) {
 link.addEventListener("click", function() {
  navLinks.classList.remove("show");
  menuBtn.setAttribute("aria-expanded", "false");
  menuBtn.textContent = "☰";
 });
});

document.getElementById("contactForm").addEventListener("submit", function(event) {
 event.preventDefault();
 alert("This contact form is not connected yet. Please use the school's official contact channel.");
});

document.getElementById("year").textContent = new Date().getFullYear();
</script>

</body>
</html>
